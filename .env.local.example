# Copy to .env.local at the repository root. Never commit actual API keys.
CLIENT_GATEWAY_URL=http://host.docker.internal:8100/integration/v1
CLIENT_GATEWAY_TOKEN=demo-client-token
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest

# Local defaults; explicit values here override Compose defaults.
PERSISTENCE_BACKEND=postgres
FILTER_PROVIDER=gemini
INTERPRETER_PROVIDER=gemini
HYPOTHESIS_PROVIDER=gemini
RISK_PROVIDER=gemini
PLANNER_PROVIDER=gemini
ENABLE_SOURCE_SCHEDULER=true
